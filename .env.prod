APP_NAME=Vietnam Motorbike Smart Traffic Assistant
APP_ENV=production
APP_PORT=8000
DEBUG=false
HOST=0.0.0.0
SECRET_KEY=prod-secret-must-be-rotated-dynamically-by-run-bat
ALLOWED_ORIGINS=https://traffic-assistant.local
OSRM_SERVER_URL=https://router.project-osrm.org
DEFAULT_CITY=Ho_Chi_Minh
DEFAULT_LATITUDE=10.7769
DEFAULT_LONGITUDE=106.7009
HAZARD_DEFAULT_RADIUS_METERS=300
LOG_LEVEL=INFO
LOG_FORMAT=json
